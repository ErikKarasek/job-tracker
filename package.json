{
  "name": "job-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "db:local": "wrangler d1 execute job-tracker-db --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute job-tracker-db --remote --file=./migrations/0001_init.sql",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy --branch main --commit-dirty=true",
    "deploy:scout": "npx --yes wrangler@4 deploy -c scout/wrangler.toml",
    "cv:sync": "node scripts/sync-cv.mjs",
    "test": "sh tests/run-all.sh",
    "test:api": "newman run tests/api/job-tracker.postman_collection.json -e tests/api/local.postman_environment.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "hono": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "newman": "^6.2.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.0.0"
  }
}
