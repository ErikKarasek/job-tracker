{
  "name": "job-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "db:local": "wrangler d1 execute job-tracker-db --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute job-tracker-db --remote --file=./migrations/0001_init.sql",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy --branch main --commit-dirty=true",
    "deploy:scout": "npx --yes wrangler@4 deploy -c scout/wrangler.toml",
    "cv:sync": "node scripts/sync-cv.mjs",
    "test": "sh tests/run-all.sh",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "test:api": "newman run tests/api/job-tracker.postman_collection.json -e tests/api/local.postman_environment.json",
    "test:e2e": "playwright test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "hono": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "newman": "^6.2.2",
    "oxlint": "^1.81.0",
    "patch-package": "8.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "handlebars": "^4.7.9",
    "lodash": "4.18.1",
    "flatted": "3.4.4",
    "underscore": "1.13.8",
    "node-forge": "^1.4.0",
    "jose": "4.15.9",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "sharp": "^0.35.5"
  },
  "auditIgnore": {
    "GHSA-qxc2-j82w-r537": "Fixed by patches/postman-collection++@faker-js+faker+5.5.3.patch: postman-collection pins faker 5.5.3 and faker 10 has a different API. Read by the weekly report in ~/Developer/devlog/src/deps.js."
  }
}
