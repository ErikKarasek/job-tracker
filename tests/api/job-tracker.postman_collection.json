{
  "info": {
    "name": "Job Tracker API",
    "description": "API tests for Job Tracker (Hono on Cloudflare Pages Functions, D1). Run in the Postman app with the local environment, or from the command line with `npm run test:api` against the test server (tests/serve.sh). Nothing here calls Workers AI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "appId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public reading",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "pm.test('answers within 1 s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "List applications (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('is an array', () => pm.expect(list).to.be.an('array'));",
                  "pm.test('every card has the fields the board needs', () => {",
                  "  for (const a of list) {",
                  "    pm.expect(a).to.include.keys('id', 'company', 'role', 'stage', 'lastActivityAt', 'createdAt');",
                  "    pm.expect(['wishlist','applied','interview','offer','rejected']).to.include(a.stage);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Access control",
      "item": [
        {
          "name": "Create without the admin key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused with 401', () => pm.response.to.have.status(401));",
                  "pm.test('says a key is needed', () => pm.expect(pm.response.json().error).to.match(/admin key/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Nobody\",\n  \"role\": \"Intruder\"\n}"
            },
            "description": "Reading the board is public; every write needs the x-admin-key header."
          }
        },
        {
          "name": "Create with a wrong admin key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "not-the-key"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Nobody\",\n  \"role\": \"Intruder\"\n}"
            }
          }
        },
        {
          "name": "Inbox without the key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the inbox is private: 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/suggestions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suggestions"
              ]
            },
            "description": "The scout's inbox holds cover letters, so even reading it needs the key."
          }
        },
        {
          "name": "AI spend without the key → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai/spend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "spend"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Application lifecycle",
      "item": [
        {
          "name": "Create an application",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const a = pm.response.json();",
                  "pm.test('starts on the wishlist, not yet applied', () => {",
                  "  pm.expect(a.stage).to.eql('wishlist');",
                  "  pm.expect(a.appliedDate).to.eql(null);",
                  "});",
                  "pm.test('salary is stored as numbers', () => {",
                  "  pm.expect(a.salaryMin).to.eql(30000);",
                  "  pm.expect(a.salaryMax).to.eql(40000);",
                  "});",
                  "pm.collectionVariables.set('appId', a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Newman Test {{runId}}\",\n  \"role\": \"Junior QA tester\",\n  \"jobUrl\": \"https://example.com/posting\",\n  \"location\": \"Pardubice\",\n  \"salaryMin\": 30000,\n  \"salaryMax\": 40000,\n  \"source\": \"Postman\"\n}"
            }
          }
        },
        {
          "name": "Create without a role → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('names what is missing', () => pm.expect(pm.response.json().error).to.eql('company and role are required'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Missing Role s.r.o.\"\n}"
            }
          }
        },
        {
          "name": "Create with an unknown stage → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('says the stage is invalid', () => pm.expect(pm.response.json().error).to.eql('invalid stage'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"X\",\n  \"role\": \"Y\",\n  \"stage\": \"hired\"\n}"
            }
          }
        },
        {
          "name": "Move to Applied",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('stage is applied', () => pm.expect(a.stage).to.eql('applied'));",
                  "pm.test('applied date is set automatically on the first move to Applied', () => pm.expect(a.appliedDate).to.be.a('string'));",
                  "pm.test('last activity moved forward', () => pm.expect(Date.parse(a.lastActivityAt)).to.be.at.least(Date.parse(a.createdAt)));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{appId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{appId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"applied\"\n}"
            }
          }
        },
        {
          "name": "Move to an unknown stage → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{appId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{appId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"hired\"\n}"
            }
          }
        },
        {
          "name": "Funnel counts the stage it reached",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('has the funnel shape', () => pm.expect(s).to.include.keys('totalCount', 'stageCounts', 'stagesReached', 'funnel'));",
                  "pm.test('counts at least our application as having reached Applied', () => pm.expect(s.stagesReached.applied).to.be.at.least(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stats/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Update a card that does not exist → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "does-not-exist"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"x\"\n}"
            }
          }
        },
        {
          "name": "Delete the application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{appId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{appId}}"
              ]
            }
          }
        },
        {
          "name": "Delete it again → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404: it is gone', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{appId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{appId}}"
              ]
            }
          }
        },
        {
          "name": "It is no longer on the board",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the deleted card is not listed', () => {",
                  "  const ids = pm.response.json().map((a) => a.id);",
                  "  pm.expect(ids).to.not.include(pm.collectionVariables.get('appId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Agent input validation",
      "item": [
        {
          "name": "Agent: no URL and no text → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 before any AI is spent', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Input is validated before the model is called, so these cost no neurons."
          }
        },
        {
          "name": "Agent: a non-http URL → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 before any AI is spent', () => pm.response.to.have.status(400));",
                  "pm.test('explains why', () => pm.expect(pm.response.json().error).to.match(/http/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"ftp://example.com/posting\"\n}"
            }
          }
        }
      ]
    }
  ]
}